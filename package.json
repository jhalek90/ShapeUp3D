{
  "name": "shapeup3d",
  "version": "0.0.1",
  "private": true,
  "description": "Free, open-source, browser-based 3D modeler for 3D printing, inspired by SketchUp Make.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
